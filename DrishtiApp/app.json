{
  "expo": {
    "name": "DrishtiApp",
    "slug": "DrishtiApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drishti.app" 
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.drishti.app" 
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./withManifestFix.js",
      "./withJetifier.js",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Drishti needs camera access to analyze your surroundings.",
          "enableMicrophonePermission": true,
          "microphonePermissionText": "Drishti needs microphone access to hear your voice commands."
        }
      ],
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Allow Drishti to access the microphone for voice interaction.",
          "speechRecognitionPermission": "Allow Drishti to securely process your voice commands."
        }
      ]
    ]
  }
}